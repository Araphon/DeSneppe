# ── Verplicht ──────────────────────────────────────────
DATABASE_URL="postgresql://gebruiker:wachtwoord@localhost:5432/admin_sneppe?schema=public"
AUTH_SECRET=""          # lange willekeurige tekst
CRON_SECRET=""          # lange willekeurige tekst (planner voor mails)
SITE_URL="https://sneppe.beehive.be"
NOINDEX="1"             # 1 = niet indexeren door Google (staging). Leeg maken bij livegang.

# ── E-mail (na overname domein) ────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="De Sneppe <info@de-sneppe.be>"

# ── Inloggen met Google (console.cloud.google.com → OAuth-client, type Web) ──
# Redirect-URI: {SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Inloggen met Microsoft (entra.microsoft.com → App-registratie, “persoonlijke + werk-accounts”) ──
# Redirect-URI: {SITE_URL}/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ── Inloggen met Apple (developer.apple.com → Services ID + Sign in with Apple-sleutel) ──
# Return URL: {SITE_URL}/api/auth/apple/callback
APPLE_CLIENT_ID=""      # Services ID, bv. be.desneppe.web
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""    # inhoud van het .p8-bestand, regeleinden als \n

# ── Cloudflare Turnstile (optioneel, bescherming tegen bots bij registratie) ──
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
